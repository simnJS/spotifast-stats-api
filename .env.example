# Copy to .env and fill in the Spotify values. Never commit .env.

# --- Required ---------------------------------------------------------------
SPOTIFY_CLIENT_ID=your-client-id
SPOTIFY_CLIENT_SECRET=your-client-secret
# Must match the Redirect URI of your Spotify app exactly. Spotify requires
# https, except for 127.0.0.1 (local development).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/callback

# --- Server -----------------------------------------------------------------
# (With docker compose, DATABASE_URL and BIND_ADDR are forced by
# docker-compose.yml: /data/spotifast.db and 0.0.0.0:8080.)
DATABASE_URL=sqlite://data/spotifast.db
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# --- Poller -----------------------------------------------------------------
# Minimum (and initial) interval between play polls, per user, in seconds.
POLL_INTERVAL_SECS=120
# Maximum interval for inactive users, in seconds (must be >= POLL_INTERVAL_SECS).
POLL_MAX_INTERVAL_SECS=600

# --- Access control ---------------------------------------------------------
# Comma-separated Spotify user ids allowed to log in. Unset/empty = anyone
# Spotify lets through.
# ALLOWED_SPOTIFY_IDS=your-spotify-id,a-friend-id
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_X_FORWARDED_FOR=false
# Requests per minute and per IP on /auth/login and /auth/callback.
AUTH_RATE_LIMIT_PER_MIN=20

# --- Spotify endpoints (override for tests only) ----------------------------
SPOTIFY_API_BASE=https://api.spotify.com/v1
SPOTIFY_ACCOUNTS_BASE=https://accounts.spotify.com
